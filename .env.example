# Autem Render — Variables de entorno (copiar a .env)
# Herramienta local de un solo usuario (sin login). Escucha solo en 127.0.0.1.

AUTEM_ENV=development
AUTEM_LOG_LEVEL=INFO

# API local (solo loopback por seguridad)
API_HOST=127.0.0.1
API_PORT=8000
CORS_ORIGINS=http://localhost:3000

# Opcional: si expones la API por túnel o GPU remota, define un token único
AUTEM_ACCESS_TOKEN=

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000

# Motores gratuitos ($0 USD)
# Pollinations Flux y Hunyuan3D-2 ZeroGPU funcionan sin clave; HF_TOKEN gratis da 5x más cuota
HF_TOKEN=
COMFYUI_URL=http://localhost:8188
OLLAMA_URL=http://localhost:11434

# Proveedores Cloud opcionales (de pago por uso)
FAL_KEY=
STABILITY_API_KEY=
TRIPO_API_KEY=
MESHY_API_KEY=
REPLICATE_API_TOKEN=
OPENAI_API_KEY=

# Control de presupuesto
AUTEM_FREE_ONLY_MODE=false
DAILY_COST_LIMIT_USD=5.0
