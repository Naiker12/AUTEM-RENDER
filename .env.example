# Autem Render — Variables de entorno (copiar a .env)

# Entorno
AUTEM_ENV=development
AUTEM_LOG_LEVEL=INFO

# PostgreSQL
POSTGRES_USER=autem
POSTGRES_PASSWORD=autem_dev_password
POSTGRES_DB=autem_render
DATABASE_URL=postgresql+psycopg://autem:autem_dev_password@localhost:5432/autem_render

# Redis (Celery broker, backend y pub/sub SSE)
REDIS_URL=redis://localhost:6379/0

# MinIO / S3
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=autem-assets
S3_REGION=us-east-1

# API
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:3000

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000

# Providers (opcionales al inicio; MockProvider funciona sin keys)
FAL_KEY=
COMFYUI_URL=http://localhost:8188
DAILY_COST_LIMIT_USD=5.0
